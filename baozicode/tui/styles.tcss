/* BaoZiCode TUI 样式 */

Screen {
    background: $surface;
}

#chat-scroll {
    height: 1fr;
    border: tall $primary;
    border-title-align: left;
    padding: 1 1;
}

/* Textual 8.x: VerticalScroll 里的子节点默认 height 不是 auto，
   必须显式声明才能撑出实际行高（否则 banner / Static / Markdown 都塌成 1 行） */
#chat-scroll > Static,
#chat-scroll > Markdown {
    width: 100%;
    height: auto;
}

/* Textual 8.x: Input 在 Screen 下是兄弟节点。如果不 dock，会按 CSS height 100%
   占满整个屏幕，把 #chat-scroll (height: 1fr) 挤到 0 行高。

   v0.3:StatusBar 也占底部 1 行,与 Input 一起占底部 4 行。
   把 StatusBar 放在 DOM 里位于 Scroll 与 Input 中间即可,无需 dock。

   v1.3 调整:StatusBar 改成「运行中显示 / 空闲隐藏」(通过 -idle class
   toggle height 1 ↔ 0)。空闲时给 #chat-scroll 多 1 行用于阅读历史。 */
#input {
    dock: bottom;
    width: 100%;
    height: 3;
    border: tall $secondary;
    padding: 0 1;
}

StatusBar {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}
/* v1.3:空闲时折叠 StatusBar(高度 0),把 1 行还给 #chat-scroll 阅读历史。
   Agent 运行中再加 -visible class 恢复 1 行。 */
StatusBar.-idle {
    height: 0;
    display: none;
}

.user-message {
    color: $success;
    text-style: bold;
    margin: 1 0 0 0;
}

.assistant-message {
    color: $text;
    margin: 0 0 1 0;
}

.error-message {
    color: $error;
    text-style: bold;
}

.info-message {
    color: $accent;
    text-style: italic;
}

SystemMessage {
    color: $warning;
    text-style: bold;
}

ModelSelectScreen {
    align: center middle;
}

#model-dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#model-dialog > Label {
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

#model-buttons {
    layout: vertical;
    height: auto;
    align-horizontal: center;
}

#model-buttons Button {
    width: 100%;
    margin: 0 0 0 0;
}

/* v1.2:ToolResultCard 按 execution_status 上色。
   5 种 status 各自一色,None 走默认(无 -block-* / -executed-* class 命中) */
ToolResultCard.-block-l1 {
    border-left: thick $error;
    color: $error;
}

ToolResultCard.-block-hook-pre {
    border-left: thick $warning;
    color: $warning;
}

ToolResultCard.-block-permission {
    /* v1.2:橙在 Textual 默认主题无内置色,用 amber 风格 */
    border-left: thick #ffa500;
    color: #ffa500;
}

ToolResultCard.-executed-success {
    border-left: thick $success;
    color: $success;
}

ToolResultCard.-executed-failed {
    border-left: thick $error;
    color: $error;
}
