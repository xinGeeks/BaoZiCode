/* BaoZiCode TUI 样式 — 参考 Claude Code 风格:无可见边框、紧凑间距、零冗余 */

Screen {
    background: $surface;
}

/* 主对话区:无边框 / 无 padding(只有 1 列水平 margin 让文字不贴边)
   内容靠自身 margin 撑行间距,Claude Code 风格。
   height: auto 让区域跟随内容高度,避免短对话时下方留白;
   内容超长时自动滚动(VerticalScroll 自带 scroll behavior)。 */
#chat-scroll {
    height: auto;
    padding: 0 1;
}

/* Textual 8.x: VerticalScroll 里的子节点默认 height 不是 auto,
   必须显式声明才能撑出实际行高(否则 banner / Static / Markdown 都塌成 1 行) */
#chat-scroll > Static,
#chat-scroll > Markdown {
    width: 100%;
    height: auto;
}

/* Input:无左侧/右侧/底部边框,只保留 1 行顶部细分隔线。
   Claude Code 风格:输入框融入主区域,只有一道线分隔。
   height: 3 保留(给 Input widget 自身 1 行 + 上下 padding 各 1)。
   Agent 运行时 StatusBar 额外占 1 行。 */
#input {
    dock: bottom;
    width: 100%;
    height: 3;
    border-top: solid $primary;
    padding: 0 1;
}

/* StatusBar:运行中显 1 行;空闲时折叠(height 0 + display:none)
   把 1 行还给 #chat-scroll 阅读历史 */
StatusBar {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
    text-style: dim;
}
StatusBar.-idle {
    height: 0;
    display: none;
}

/* 消息间距:Claude Code 风格 — 用户和 assistant 之间无空行,
   只靠颜色区分,markdown / tool 块自带 padding。 */
.user-message {
    color: $success;
    text-style: bold;
    margin: 1 0 0 0;
}

.assistant-message {
    color: $text;
    margin: 0;
}

.error-message {
    color: $error;
    text-style: bold;
    margin: 1 0 0 0;
}

.info-message {
    color: $accent;
    text-style: italic;
    margin: 0;
}

SystemMessage {
    color: $warning;
    text-style: bold;
}

/* ---- 弹窗:ModelSelectScreen / PermissionModal 保留独立边框(模态隔离需要) ---- */

ModelSelectScreen {
    align: center middle;
}

#model-dialog {
    width: 60;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

#model-dialog > Label {
    width: 100%;
    content-align: center middle;
    margin-bottom: 1;
}

#model-buttons {
    layout: vertical;
    height: auto;
    align-horizontal: center;
}

#model-buttons Button {
    width: 100%;
    margin: 0;
}

/* ---- Tool 卡片紧凑 ---- */

ToolCallCard {
    height: auto;
    margin: 0;
    padding: 0 1;
    background: $boost;
    border-left: thick $primary;
}

ToolResultCard {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $boost;
    border-left: thick $secondary;
}

/* v1.2:ToolResultCard 按 execution_status 上色。
   5 种 status 各自一色,None 走默认(无 -block-* / -executed-* class 命中) */
ToolResultCard.-block-l1 {
    border-left: thick $error;
    color: $error;
}

ToolResultCard.-block-hook-pre {
    border-left: thick $warning;
    color: $warning;
}

ToolResultCard.-block-permission {
    /* v1.2:橙在 Textual 默认主题无内置色,用 amber 风格 */
    border-left: thick #ffa500;
    color: #ffa500;
}

ToolResultCard.-executed-success {
    border-left: thick $success;
    color: $success;
}

ToolResultCard.-executed-failed {
    border-left: thick $error;
    color: $error;
}